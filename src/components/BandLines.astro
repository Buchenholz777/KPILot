---
/** Dekorative, sehr dezente Diagrammlinien für den dunklen Markenbereich. */
---

<svg class="band-lines" viewBox="0 0 720 260" aria-hidden="true" focusable="false" preserveAspectRatio="xMaxYMax meet">
  <defs>
    <linearGradient id="bl-fade" x1="0" x2="1">
      <stop offset="0" stop-color="#A5B4FC" stop-opacity="0"></stop>
      <stop offset="0.5" stop-color="#A5B4FC" stop-opacity="0.45"></stop>
      <stop offset="1" stop-color="#A5B4FC" stop-opacity="0.7"></stop>
    </linearGradient>
    <linearGradient id="bl-fade2" x1="0" x2="1">
      <stop offset="0" stop-color="#5EEAD4" stop-opacity="0"></stop>
      <stop offset="1" stop-color="#5EEAD4" stop-opacity="0.55"></stop>
    </linearGradient>
  </defs>
  <path d="M0 230 C 90 220, 140 200, 210 196 S 330 170, 400 150 S 520 120, 590 86 S 680 40, 720 24" fill="none" stroke="url(#bl-fade)" stroke-width="1.6"></path>
  <path d="M0 250 C 120 246, 200 232, 280 226 S 420 204, 500 192 S 640 160, 720 140" fill="none" stroke="url(#bl-fade2)" stroke-width="1.3" stroke-dasharray="3 5"></path>
  <g fill="#A5B4FC" fill-opacity="0.55">
    <circle cx="400" cy="150" r="3"></circle>
    <circle cx="590" cy="86" r="3"></circle>
    <circle cx="720" cy="24" r="3"></circle>
  </g>
  <g fill="#ffffff" fill-opacity="0.05">
    <rect x="452" y="170" width="22" height="90" rx="3"></rect>
    <rect x="490" y="140" width="22" height="120" rx="3"></rect>
    <rect x="528" y="156" width="22" height="104" rx="3"></rect>
    <rect x="566" y="110" width="22" height="150" rx="3"></rect>
    <rect x="604" y="84" width="22" height="176" rx="3"></rect>
    <rect x="642" y="60" width="22" height="200" rx="3"></rect>
  </g>
</svg>
