---
import { getCalc } from '../calc/all';
import { TOPIC_BY_ID, topicUrl, displayTitle } from '../data/registry';
import Field from './Field.astro';
import FavButton from './FavButton.astro';
import Icon from './Icon.astro';
import { fieldGuide } from '../data/field-guides';
import { runExample } from '../calc/engine';
import { formatValue } from '../lib/number';

interface Props {
  id: string;
}
const { id } = Astro.props;
const calc = getCalc(id);
const topic = TOPIC_BY_ID[id];
const multi = calc.variants.length > 1;
const scenVariant = calc.scenario ? calc.variants.find((v) => v.id === calc.scenario!.variantId) : undefined;
const transfers = (calc.transfers ?? []).map((t) => ({ ...t, url: topicUrl(t.target), targetTitle: displayTitle(TOPIC_BY_ID[t.target]) }));
const exV = calc.variants[0];
const exR = runExample(exV);
const examplePreview = exR.status === 'ok' ? { label: exR.main.label, value: formatValue(exR.main.value, exR.main.format, exR.main.unit, exR.main.signed) } : undefined;
const rowCount = (min: number) => Math.max(min, 2);
const scenFields = scenVariant ? scenVariant.fields.filter((f) => f.key !== 'zeitraum') : [];
const scenPeriod = scenVariant?.fields.find((f) => f.key === 'zeitraum');
const scenNames = ['Vorsichtig', 'Realistisch', 'Optimistisch'];
---

<section class="calc" id="rechner" data-calc={id} data-cat={topic.category} data-title={displayTitle(topic)} aria-labelledby="calc-h">
  <div class="calc-head">
    <h2 id="calc-h">Rechner</h2>
    <span class="badge">Startet leer · rechnet automatisch</span>
  </div>

  <div class="calc-notice notice notice-info" data-notice role="status" hidden></div>

  {
    multi && (
      <>
        <fieldset class="variants">
          <legend>Was möchtest du berechnen?</legend>
          {calc.variants.map((v, i) => (
            <button type="button" class="variant-btn" data-variant-btn={v.id} aria-pressed={i === 0 ? 'true' : 'false'}>
              {v.label}
            </button>
          ))}
        </fieldset>
        <div class="variant-fav-row">
          {calc.variants.map((v, i) => (
            <span data-variant-fav={v.id} hidden={i > 0 ? true : undefined}>
              <FavButton id={`${id}#${v.id}`} name={v.favLabel} labeled offText="Diesen Modus als Favorit merken" onText="Dieser Modus ist ein Favorit" />
            </span>
          ))}
        </div>
      </>
    )
  }

  <div class="calc-grid">
    <div class="calc-in card">
      <h3 class="calc-col-title">Deine Eingaben</h3>
      {
        calc.variants.map((v, i) => (
          <form class="calc-form" data-form={v.id} hidden={i > 0 ? true : undefined} novalidate aria-label={multi ? v.favLabel : `${topic.title} berechnen`}>
            {v.question && <p class="calc-question">{v.question}</p>}
            <p class="example-flag" data-example-flag hidden>
              <Icon name="example" /> <strong>Beispielwerte</strong> – ersetze sie durch deine eigenen Zahlen.
            </p>
            {v.fields.length > 0 && (
              <div class="fields">
                {v.fields.map((f) => (
                  <Field f={f} prefix={`${id}-${v.id}`} guide={fieldGuide(id, f.key)} />
                ))}
              </div>
            )}
            {v.rows && (
              <div class="field rows-field" data-rows={v.rows.key} data-min={v.rows.minRows} data-max={v.rows.maxRows}>
                <div class="table-scroll" tabindex="0" role="region" aria-label={`${v.rows.label} – bei Bedarf horizontal scrollbar`}>
                  <table class="rows-table">
                    <caption class="visually-hidden">{v.rows.label}</caption>
                    <thead>
                      <tr>
                        {v.rows.columns.map((c) => (
                          <th scope="col">
                            {c.label}
                            {c.unit && <span class="muted"> ({c.unit})</span>}
                          </th>
                        ))}
                        <th scope="col">
                          <span class="visually-hidden">Zeile entfernen</span>
                        </th>
                      </tr>
                    </thead>
                    <tbody data-rows-body>
                      {Array.from({ length: rowCount(v.rows.minRows) }, (_, ri) => (
                        <tr>
                          {v.rows!.columns.map((c, ci) => (
                            <td>
                              <div class="input-wrap">
                                <input
                                  type="text"
                                  inputmode={c.min === 'any' ? 'text' : c.integer ? 'numeric' : 'decimal'}
                                  autocomplete="off"
                                  spellcheck="false"
                                  maxlength="24"
                                  data-col={ci}
                                  aria-label={`${c.label}, Zeile ${ri + 1}`}
                                />
                              </div>
                              <p class="field-error" data-cell-error hidden />
                            </td>
                          ))}
                          <td>
                            <button type="button" class="icon-btn" data-remove-row aria-label={`Zeile ${ri + 1} entfernen`}>
                              <Icon name="trash" />
                            </button>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                {v.rows.columns.some((c) => c.help) && (
                  <p class="help">
                    {v.rows.columns
                      .filter((c) => c.help)
                      .map((c) => `${c.label}: ${c.help}`)
                      .join(' · ')}
                  </p>
                )}
                <button type="button" class="btn btn-ghost" data-add-row>
                  <Icon name="plus" />
                  {v.rows.addLabel}
                </button>
                <p class="field-error" data-rows-error hidden />
              </div>
            )}
            <div class="form-actions">
              <button type="submit" class="btn btn-primary">
                <Icon name="calc" />
                Berechnen
              </button>
              <button type="button" class="btn btn-secondary" data-action="example">
                <Icon name="example" />
                Beispiel einsetzen
              </button>
              <button type="button" class="btn btn-ghost" data-action="reset">
                <Icon name="reset" />
                Zurücksetzen
              </button>
            </div>
          </form>
        ))
      }
    </div>

    <div class="calc-out card" aria-labelledby="calc-out-h">
      <h3 class="calc-col-title" id="calc-out-h">Dein Ergebnis</h3>
      <div class="result" data-result data-state="empty" tabindex="-1">
        <p class="result-missing">Gib deine Werte ein oder setze das Beispiel ein – das Ergebnis erscheint automatisch.</p>
        {
          examplePreview && (
            <div class="result-preview" aria-label="Vorschau: So sieht ein Ergebnis aus">
              <p class="result-tag">Vorschau mit Beispielwerten</p>
              <p class="result-main-label">{examplePreview.label}</p>
              <p class="result-main">{examplePreview.value}</p>
              <p class="small muted">Mit Rechenweg, {scenVariant ? 'Variantenvergleich' : 'Einordnung'} und Weiterverwendung der Werte in passenden Rechnern.</p>
            </div>
          )
        }
      </div>
      <div class="visually-hidden" aria-live="polite" data-announce></div>

      <div class="calc-tools" data-tools hidden>
        <h4 class="tools-title">Ergebnis nutzen</h4>
        <div class="tools-row" role="group" aria-label="Ergebnis kopieren, speichern, drucken">
          <button type="button" class="btn btn-secondary" data-tool="copy"><Icon name="copy" />Kopieren</button>
          <button type="button" class="btn btn-secondary" data-tool="save"><Icon name="save" />Speichern</button>
          <button type="button" class="btn btn-secondary" data-tool="print"><Icon name="print" />Drucken</button>
          {scenVariant && <button type="button" class="btn btn-secondary" data-tool="compare"><Icon name="chart" />Varianten vergleichen</button>}
        </div>
        <p class="save-status" role="status" data-save-status hidden></p>
      </div>

      <section class="followups" data-followups hidden aria-labelledby="followups-h">
        <h4 class="tools-title" id="followups-h">Nächster Schritt</h4>
        <ul data-followup-list></ul>
        <div class="capacity" data-capacity hidden>
          <div class="field">
            <label for={`${id}-cap`} data-capacity-label>Verfügbare Kapazität</label>
            <div class="input-wrap">
              <input id={`${id}-cap`} type="text" inputmode="numeric" autocomplete="off" maxlength="24" data-capacity-input aria-describedby={`${id}-cap-help`} />
              <span class="unit" data-capacity-unit>Stück</span>
            </div>
            <p class="help" id={`${id}-cap-help`} data-capacity-help>Im selben Zeitraum und in derselben Einheit wie die berechnete Menge.</p>
          </div>
          <p class="capacity-result" data-capacity-result role="status" hidden></p>
        </div>
      </section>

      {
        transfers.length > 0 && (
          <div class="transfers" data-transfers hidden>
            <h4 class="tools-title">Werte weiterverwenden</h4>
            <ul>
              {transfers.map((t) => (
                <li>
                  <button type="button" class="btn btn-secondary" data-transfer={t.target} data-transfer-url={t.url}>
                    {t.label}
                    <Icon name="arrow" />
                  </button>
                </li>
              ))}
            </ul>
            <p class="help">Übernommen werden nur Werte mit gleicher Bedeutung. Fehlende Angaben trägst du im Zielrechner selbst ein.</p>
          </div>
        )
      }
    </div>
  </div>

  <div class="calc-wide">
    {
      scenVariant && (
        <details class="scenario card" data-scenario={scenVariant.id}>
          <summary>Varianten vergleichen: zwei Szenarien (A/B)</summary>
          <p class="small muted">
            Vergleiche deine eigenen Annahmen nebeneinander, z. B. einen anderen Preis oder andere Fixkosten. Das ist keine Prognose und enthält keine Marktdaten – die Werte trägst du ein.
          </p>
          {scenPeriod && (
            <div class="scn-shared">
              <Field f={scenPeriod} prefix={`scn-shared-${id}`} compact />
              <p class="help">Der Zeitraum gilt für beide Szenarien. KPILot rechnet nicht automatisch zwischen Zeiträumen um (das würde gleichmäßige Verteilung ohne Saisoneffekte unterstellen): Trage in beiden Szenarien Werte für diesen Zeitraum ein.</p>
            </div>
          )}
          <button type="button" class="btn btn-secondary" data-scn-copy>
            Aktuelle Eingaben in A und B übernehmen
          </button>
          <div class="scenario-grid">
            {['A', 'B'].map((s) => (
              <form class="scenario-col" data-scn={s} novalidate aria-label={`Szenario ${s}`} onsubmit="return false">
                <h4>Szenario {s}</h4>
                <div class="field">
                  <label for={`scn${s}-${id}-name`}>Name <span class="muted">(optional)</span></label>
                  <div class="input-wrap">
                    <input id={`scn${s}-${id}-name`} name="scnName" list={`scn-names-${id}`} maxlength="30" autocomplete="off" placeholder={s === 'A' ? 'z. B. Vorsichtig' : 'z. B. Optimistisch'} />
                  </div>
                </div>
                <div class="fields">
                  {scenFields.map((f) => (
                    <Field f={f} prefix={`scn${s}-${id}`} guide={fieldGuide(id, f.key)} compact />
                  ))}
                </div>
              </form>
            ))}
          </div>
          <datalist id={`scn-names-${id}`}>
            {scenNames.map((n) => (
              <option value={n} />
            ))}
          </datalist>
          <div class="scn-result" data-scn-result aria-live="polite" />
          <div class="scn-chart" data-scn-chart />
        </details>
      )
    }
  </div>

  <p class="privacy-note">Deine Zahlen werden nur in diesem Browser berechnet und nicht an einen Berechnungsserver übertragen.</p>

  <dialog data-save-dialog aria-labelledby="save-h">
    <form method="dialog" data-save-form>
      <h2 id="save-h">Berechnung speichern</h2>
      <p class="small muted">Meine Berechnungen bleiben auf diesem Gerät in diesem Browser. Mit „Sicherung herunterladen“ unter „Meine Berechnungen“ kannst du sie auf ein anderes Gerät mitnehmen.</p>
      <div class="field">
        <label for="save-name">Name der Berechnung</label>
        <div class="input-wrap"><input id="save-name" name="name" maxlength="80" autocomplete="off" /></div>
      </div>
      <div class="field">
        <label for="save-project">Vorhaben <span class="muted">(optional, z. B. Angebot, Produkt, Kampagne)</span></label>
        <div class="input-wrap">
          <select id="save-project" name="project" data-save-project>
            <option value="">Ohne Vorhaben</option>
            <option value="__new">Neues Vorhaben anlegen …</option>
          </select>
        </div>
      </div>
      <div class="field" data-save-newproject hidden>
        <label for="save-newproject">Name des neuen Vorhabens</label>
        <div class="input-wrap"><input id="save-newproject" name="newproject" maxlength="80" autocomplete="off" /></div>
      </div>
      <div class="field">
        <label for="save-note">Notiz zu Annahmen <span class="muted">(optional)</span></label>
        <div class="input-wrap"><textarea id="save-note" name="note" rows="3" maxlength="2000"></textarea></div>
        <p class="help">Z. B. welche Werte geschätzt sind. Die Notiz bleibt lokal in deinem Browser.</p>
      </div>
      <div class="form-actions">
        <button value="save" class="btn btn-primary">Speichern</button>
        <button value="cancel" class="btn btn-secondary" formnovalidate>Abbrechen</button>
      </div>
    </form>
  </dialog>
</section>

<script>
  import '../scripts/calculator';
</script>
