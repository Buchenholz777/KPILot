---
import { technicalChangeDate, formatIsoDe, topicFile } from '../lib/content-meta';
import type { Topic } from '../data/types';
/** Quellen, Verantwortung und Stand. Zeigt nur, was tatsächlich bekannt ist. */
interface Props {
  topic: Topic;
}
const { topic: t } = Astro.props;
const changed = technicalChangeDate(topicFile(t.category));
---

<section class="card content-card" aria-labelledby="quellen">
  <h2 id="quellen">Quellen, Verantwortung und Stand</h2>
  {
    t.sources && t.sources.length > 0 ? (
      <p>
        <strong>Fachliche Quellen:</strong>{' '}
        {t.sources.map((s, i) => (
          <>
            {i > 0 && ' · '}
            <a href={s.url} rel="noopener" target="_blank">{s.label}</a>
          </>
        ))}
        . Das Modell hier ist bewusst vereinfacht.
      </p>
    ) : (
      <p>
        <strong>Fachliche Grundlage:</strong> gängige betriebswirtschaftliche Lehrbuchdarstellung. Für diesen Rechner ist keine einzelne Primärquelle hinterlegt; Definition und Herleitung stehen in den
        <a href="#formel">Formeln</a> und den <a href="#annahmen">Modellannahmen</a>.
      </p>
    )
  }
  <p><strong>Verwendete Modellvariante:</strong> {t.assumptions.slice(0, 2).join(' · ')} Die vollständigen <a href="#annahmen">Modellannahmen</a> stehen oben.</p>
  <dl class="status-list">
    <dt>Verantwortlich für die Inhalte</dt>
    <dd>der Betreiber von KPILot (siehe <a href="/impressum/">Impressum</a>); weitere Qualifikationen sind nicht belegt und werden deshalb nicht genannt.</dd>
    <dt>Automatisierte Prüfung</dt>
    <dd>Das Beispiel dieses Rechners ist berechenbar und wird mit Unit-Tests geprüft; Rechenregeln, Randfälle und Rundung sind durch Tests mit unabhängig berechneten Erwartungswerten abgesichert. Das ist keine fachliche Inhaltsprüfung (<a href="/ueber/#verantwortung">Wie wir prüfen</a>).</dd>
    <dt>Fachliche Inhaltsprüfung durch Dritte</dt>
    <dd>nicht dokumentiert.</dd>
    {changed && (<><dt>Technische Änderung</dt><dd>zuletzt am {formatIsoDe(changed)} (Änderungsdatum der Inhaltsdatei – kein Prüfdatum).</dd></>)}
  </dl>
</section>
