---
import Base from '../../layouts/Base.astro';
import PageBand from '../../components/PageBand.astro';
import { buildCases } from '../../data/cases';
import { topicUrl, TOPIC_BY_ID, displayTitle } from '../../data/registry';

const crumbs = [
  { name: 'Start', href: '/' },
  { name: 'Praxisfälle', href: '/praxisfaelle/' },
];
const cases = buildCases();
const N = cases.length;
const words = ['', 'Ein', 'Zwei', 'Drei', 'Vier', 'Fünf', 'Sechs'];
---

<Base
  title={`Praxisfälle: ${cases.map((c) => c.sector).join(', ')} | KPILot`}
  description={`${N} durchgerechnete, ausdrücklich fiktive Fälle mit Ausgangsfrage, Annahmen, Rechnung, Ergebnis, Variantenvergleich und nächstem Prüfschritt – zum Weiterrechnen mit deinen Zahlen.`}
  crumbs={crumbs}
>
  <PageBand crumbs={crumbs} title="Praxisfälle" lead={`${words[N] ?? N} vollständig durchgerechnete Fälle. Alle Annahmen sind ausdrücklich fiktiv; alle Zahlen, Tabellen und Übernahmen entstehen aus denselben Falldaten und Rechenfunktionen wie die Rechner.`} />
  <div class="container page-body">
    <nav aria-label="Fälle" class="case-nav">
      <ul class="empty-links">{cases.map((c) => <li><a href={`#${c.id}`}>{c.sector}: {c.title.split(': ')[1]}</a></li>)}</ul>
    </nav>
    {
      cases.map((c) => (
        <article class="card content-card case" id={c.id} aria-labelledby={`${c.id}-h`}>
          <p class="eyebrow">{c.sector} · fiktives Beispiel · Zeitraum: {c.period} · Einheit: {c.unit}</p>
          <h2 id={`${c.id}-h`}>{c.title}</h2>
          <p class="case-question"><strong>Ausgangsfrage:</strong> {c.question}</p>
          <p class="step-links">
            <button type="button" class="btn btn-primary" data-case-transfer={JSON.stringify(c.primary)} data-case-url={c.primary.url}>{c.primary.label}</button>
            <span class="small muted">Alle Werte des Falls werden zusammen übernommen; du kannst sie danach anpassen. Bestehende Entwürfe werden nicht überschrieben, ohne dass du es bestätigst.</span>
          </p>
          <h3>Annahmen (fiktiv)</h3>
          <ul class="bullets">{c.assumptions.map((a) => <li>{a}</li>)}</ul>
          <h3>Rechnung</h3>
          <ol class="case-steps">
            {c.steps.map((s) => (
              <li>
                <h4>{s.title}</h4>
                <p>{s.text}</p>
                <ul class="bullets">{s.lines.map((l) => <li>{l}</li>)}</ul>
                <p class="step-links">
                  <button type="button" class="btn btn-secondary" data-case-transfer={JSON.stringify(s.transfer)} data-case-url={s.transfer.url}>{s.transfer.label}</button>
                  <span class="small muted">{displayTitle(TOPIC_BY_ID[s.calc])}{s.variant ? ` (Modus: ${s.variant})` : ''}</span>
                </p>
              </li>
            ))}
          </ol>
          <h3>Ergebnis</h3>
          <p class="home-example-result">{c.result}</p>
          <h3>Vergleich</h3>
          <div class="table-scroll" tabindex="0" role="region" aria-label={`Vergleich ${c.sector}, bei Bedarf horizontal scrollbar`}>
            <table class="compare-table">
              <caption>{c.compare.title}</caption>
              <thead><tr>{c.compare.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
              <tbody>
                {c.compare.rows.map((r) => (
                  <tr><th scope="row">{r[0]}</th>{r.slice(1).map((x) => <td>{x}</td>)}</tr>
                ))}
              </tbody>
            </table>
          </div>
          <h3>So deutest du es richtig</h3>
          <ul class="bullets">{c.notes.map((n) => <li>{n}</li>)}</ul>
          <h3>Nächster sinnvoller Prüfschritt</h3>
          <p>{c.next}</p>
          {
            c.more.length > 0 && (
              <p class="step-links">
                {c.more.map((t) => (
                  <button type="button" class="btn btn-secondary" data-case-transfer={JSON.stringify(t)} data-case-url={t.url}>{t.label}</button>
                ))}
              </p>
            )
          }
          <p class="small muted">Übernommen werden nur die Eingaben des Falls (keine Ergebniszahlen); du kannst sie im Rechner durch eigene ersetzen. Änderst du Werte, ist es deine abgewandelte Berechnung.</p>
        </article>
      ))
    }
  </div>
</Base>

<script>
  import { setTransfer } from '../../lib/storage';
  import { track } from '../../lib/analytics';
  import { toast } from '../../scripts/ui';
  type T = { target: string; url: string; values: Record<string, string>; describe: string; fromTitle: string };
  document.querySelectorAll<HTMLButtonElement>('[data-case-transfer]').forEach((b) =>
    b.addEventListener('click', () => {
      const t = JSON.parse(b.dataset.caseTransfer!) as T;
      const ok = setTransfer({ from: 'praxisfall', fromTitle: t.fromTitle, target: t.target, values: t.values, describe: t.describe });
      if (!ok) return toast('Die Übernahme braucht den Sitzungsspeicher des Browsers, der hier nicht verfügbar ist.');
      track('values_transferred', { calc: 'praxisfall', variant: t.target });
      location.href = b.dataset.caseUrl!;
    }),
  );
</script>
