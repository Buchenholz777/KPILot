---
import Base from '../layouts/Base.astro';
import Catalog from '../components/Catalog.astro';
import Favorites from '../components/Favorites.astro';
import KpiInfo from '../components/KpiInfo.astro';
import { SITE_NAME, SITE_DESCRIPTION } from '../config/site';
import { HOME_FAQ } from '../data/faq';

const site = Astro.site;
const websiteLd = site
  ? [
      { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: site.href, inLanguage: 'de-DE', description: SITE_DESCRIPTION },
      {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: HOME_FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
      },
    ]
  : [];
---

<Base
  title={`KPI Rechner – Kostenlos Key Performance Indicators berechnen | ${SITE_NAME}`}
  description="Berechne deine wichtigsten Unternehmens-KPIs schnell und kostenlos mit KPILot. Das einfache Tool für Conversion Rate, ROI, CAC und mehr."
  jsonLd={websiteLd}
>
  <Catalog mode="home">
    <Fragment slot="intro">
      <h1 class="hero-title">Kostenloser KPI Rechner <span class="accent">für dein Business</span></h1>
      <p class="hero-sub">40 Rechner mit Erklärung und Rechenweg</p>
    </Fragment>
    <Favorites slot="between" layout="row" />
  </Catalog>
  <KpiInfo />
</Base>
