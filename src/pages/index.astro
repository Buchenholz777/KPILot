---
import Base from '../layouts/Base.astro';
import Catalog from '../components/Catalog.astro';
import Favorites from '../components/Favorites.astro';
import KpiInfo from '../components/KpiInfo.astro';
import TaskTiles from '../components/TaskTiles.astro';
import HomeExample from '../components/HomeExample.astro';
import { TOPICS } from '../data/registry';
import { SITE_NAME, SITE_DESCRIPTION } from '../config/site';
import { HOME_FAQ } from '../data/faq';

const site = Astro.site;
const websiteLd = site
  ? [
      { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: site.href, inLanguage: 'de-DE', description: SITE_DESCRIPTION },
      {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: HOME_FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
      },
    ]
  : [];
---

<Base
  title={`KPI Rechner – Preise kalkulieren, Wirtschaftlichkeit prüfen, Kennzahlen verstehen | ${SITE_NAME}`}
  description={`Kostenlose Rechner für Preis, Rabatt, Break-even, Gewinn, Werbung und Liquidität – ${TOPICS.length} Rechner mit nachvollziehbarem Rechenweg, Variantenvergleich und Weiterverwendung der Werte.`}
  jsonLd={websiteLd}
>
  <Catalog mode="home">
    <Fragment slot="intro">
      <h1 class="hero-title">Preise kalkulieren. <span class="accent">Wirtschaftlichkeit prüfen. Kennzahlen verstehen.</span></h1>
      <p class="hero-sub">
        {TOPICS.length} kostenlose Rechner mit nachvollziehbarem Rechenweg. Vergleiche Varianten und nimm deine Werte in den nächsten Rechner mit.
      </p>
    </Fragment>
    <Fragment slot="between">
      <section class="home-tasks" aria-labelledby="aufgaben-h">
        <div class="home-tasks-head">
          <h2 id="aufgaben-h">Womit möchtest du starten?</h2>
          <a class="home-flow-link" href="/ablauf/preis-wirtschaftlichkeit/">Preis und Gewinn gemeinsam kalkulieren <span aria-hidden="true">→</span></a>
        </div>
        <TaskTiles />
      </section>
      <Favorites layout="row" />
    </Fragment>
  </Catalog>
  <HomeExample />
  <KpiInfo />
</Base>
