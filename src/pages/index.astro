---
import Base from '../layouts/Base.astro';
import Catalog from '../components/Catalog.astro';
import Favorites from '../components/Favorites.astro';
import KpiInfo from '../components/KpiInfo.astro';
import TaskTiles from '../components/TaskTiles.astro';
import HomeExample from '../components/HomeExample.astro';
import QuickAccess from '../components/QuickAccess.astro';
import { TOPICS } from '../data/registry';
import { SITE_NAME, SITE_DESCRIPTION } from '../config/site';

const site = Astro.site;
const websiteLd = site
  ? [
      { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: site.href, inLanguage: 'de-DE', description: SITE_DESCRIPTION },
      {
        '@context': 'https://schema.org',
        '@type': 'WebApplication',
        name: 'KPILot',
        url: site.href,
        applicationCategory: 'BusinessApplication',
        operatingSystem: 'Alle (läuft im Webbrowser)',
        browserRequirements: 'Benötigt JavaScript',
        inLanguage: 'de-DE',
        description: `Kostenloser KPI Rechner: ${TOPICS.length} Rechner für Key Performance Indicators wie Conversion Rate, ROI, CAC, CLV, Marge, Deckungsbeitrag und Break-even – mit Formel, Erklärung und nachvollziehbarem Rechenweg. Alle Berechnungen laufen im Browser, ohne Anmeldung.`,
        image: new URL('/og-image.png', site).href,
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
      },
    ]
  : [];
---

<Base
  title={`KPI-Rechner kostenlos: ${TOPICS.length} Online-Rechner mit Formeln | ${SITE_NAME}`}
  description={`Berechne deine wichtigsten Unternehmenskennzahlen kostenlos: Marge, ROI, Break-even, Cashflow und mehr. ${TOPICS.length} Online-Rechner mit Formeln und Beispielen.`}
  jsonLd={websiteLd}
>
  <Catalog mode="home">
    <Fragment slot="intro">
      <h1 class="hero-title">KPI-Rechner: <span class="accent">Berechnen statt schätzen.</span></h1>
      <p class="hero-sub">
        Kostenlose Online-Rechner für Marge, Gewinnschwelle, Deckungsbeitrag, Cashflow und viele weitere betriebswirtschaftliche Kennzahlen – einfach erklärt, direkt berechnet.
      </p>
      <ul class="hero-trust" aria-label="Vorteile">
        <li>Kostenlos</li>
        <li>Ohne Anmeldung</li>
        <li>Formeln und Rechenweg</li>
        <li>Berechnung im Browser</li>
      </ul>
    </Fragment>
    <Fragment slot="between">
      <QuickAccess />
      <section class="home-tasks" aria-labelledby="aufgaben-h">
        <h2 id="aufgaben-h">Womit möchtest du starten?</h2>
        <TaskTiles />
      </section>
      <Favorites layout="row" />
    </Fragment>
  </Catalog>
  <HomeExample />
  <KpiInfo />
</Base>
